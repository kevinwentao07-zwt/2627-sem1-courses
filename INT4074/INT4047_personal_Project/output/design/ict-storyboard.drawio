" /></mxCell><mxCell id="saved" value="Save succeeded?" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=20;fillColor=#f1eadc;strokeColor=#b3c0b0;" vertex="1" parent="1"><mxGeometry x="1200" y="655" width="360" height="125" as="geometry" /></mxCell><mxCell id="failure" value="O: Storage error + retry guidance&#10;Retain draft; roll back this attempt" style="shape=parallelogram;rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=20;fillColor=#e4eddf;strokeColor=#b3c0b0;" vertex="1" parent="1"><mxGeometry x="640" y="150" width="360" height="125" as="geometry" /></mxCell><mxCell id="feedback" value="O: Feedback in the same position&#10;Written: reference points + optional&#10;self-assessment, saved separately" style="shape=parallelogram;rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=20;fillColor=#e4eddf;strokeColor=#b3c0b0;" vertex="1" parent="1"><mxGeometry x="1200" y="460" width="360" height="125" as="geometry" /></mxCell><mxCell id="more" value="More questions?&#10;I: Next / Finish" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=20;fillColor=#f1eadc;strokeColor=#b3c0b0;" vertex="1" parent="1"><mxGeometry x="1200" y="305" width="360" height="125" as="geometry" /></mxCell><mxCell id="finish" value="B / Continue on page 03&#10;Finish the practice session" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=20;fillColor=#ffffff;strokeColor=#b3c0b0;" vertex="1" parent="1"><mxGeometry x="1200" y="150" width="360" height="110" as="geometry" /></mxCell><mxCell id="edge0" source="question" target="answer" value="" style="exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;edgeStyle=none;rounded=0;endArrow=block;html=0;fontSize=17;strokeColor=#3c6352;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="260" as="sourcePoint" /><mxPoint x="270" y="305" as="targetPoint" /><Array as="points" /></mxGeometry></mxCell><mx