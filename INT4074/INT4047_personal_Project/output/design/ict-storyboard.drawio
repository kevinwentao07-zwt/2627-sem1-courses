etry x="665" y="149" width="1550" height="36" as="geometry" /></mxCell><mxCell id="text3" value="Written self-assessment is not an official DSE mark." style="text;html=0;align=left;fontFamily=Arial;fontSize=18;fontColor=#29332e;" vertex="1" parent="1"><mxGeometry x="665" y="187" width="1550" height="33" as="geometry" /></mxCell><mxCell id="text4" value="Accuracy is shown with its question sample size." style="text;html=0;align=left;fontFamily=Arial;fontSize=18;fontColor=#29332e;" vertex="1" parent="1"><mxGeometry x="665" y="220" width="1550" height="33" as="geometry" /></mxCell><mxCell id="text5" value="No login, cloud sync or automatic AI analysis yet." style="text;html=0;align=left;fontFamily=Arial;fontSize=18;fontColor=#29332e;" vertex="1" parent="1"><mxGeometry x="665" y="253" width="1550" height="33" as="geometry" /></mxCell><mxCell id="text6" value="Completion save failure: roll back progress and rewards, then retry." style="text;html=0;align=left;fontFamily=Arial;fontSize=17;fontColor=#29332e;" vertex="1" parent="1"><mxGeometry x="665" y="863" width="1550" height="32" as="geometry" /></mxCell><mxCell id="text7" value="Navigating away preserves Learn position; active question timing pauses until the view becomes visible again." style="text;html=0;align=left;fontFamily=Arial;fontSize=18;fontColor=#29332e;" vertex="1" parent="1"><mxGeometry x="665" y="1024" width="1550" height="33" as="geometry" /></mxCell><mxCell id="text8" value="I = learner input | O = software output | Dashed = future extension" style="text;html=0;align=left;fontFamily=Arial;fontSize=17;fontColor=#29332e;" vertex="1" parent="1"><mxGeometry x="65" y="1103" width="1550" height="32" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>